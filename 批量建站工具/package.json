{
  "name": "sitefoundry-batch-publisher",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "templates:build": "node scripts/build-template-packages.mjs",
    "motion:build": "node scripts/build-site-motion.mjs",
    "template:new": "node scripts/create-template.mjs",
    "predev": "npm run templates:build && npm run motion:build",
    "prebuild": "npm run templates:build && npm run motion:build && node scripts/check-offline-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:source-runtime": "node scripts/build-source-export-runtime.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "offline:start": "node dist/sitefoundry-server.mjs",
    "fonts:vendor": "node scripts/vendor-offline-fonts.mjs",
    "apps:windows": "npm --prefix apps/windows run dist",
    "apps:android": "npm --prefix apps/android run build",
    "apps:android:debug": "npm --prefix apps/android run build:debug",
    "apps:runtime:prepare": "node apps/build-runtime/prepare-runtime.mjs",
    "test": "vitest run && node tests/verify-differentiated-copies.cjs && node tests/game-builder.smoke.cjs",
    "test:watch": "vitest",
    "test:domain-corpus": "node scripts/evaluate-domain-corpus.mjs",
    "fixtures": "node scripts/generate-test-fixtures.mjs"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "libarchive.js": "^2.0.2",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "esbuild": "0.25.12",
    "linkedom": "0.18.12",
    "vite": "7.1.4",
    "vitest": "3.2.4"
  }
}
